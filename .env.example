# ── SentinelLens Configuration ────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Dashboard Auth (REQUIRED) ─────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-32-char-string
FLASK_ENV=development
LOG_LEVEL=INFO

# ── Data Source ────────────────────────────────────────────────────────────────
BOTS_DATA_PATH=data/bots_sample_events.json
MODEL_PATH=models/scorer_v1.joblib

# ── Correlation Engine ─────────────────────────────────────────────────────────
CORRELATION_WINDOW_MINUTES=15
MIN_CLUSTER_SIZE=2

# ── Splunk (Phase 1 — leave empty to use local data) ──────────────────────────
SPLUNK_HOST=
SPLUNK_PORT=8089
SPLUNK_TOKEN=

# ── Investigation Agent (Phase 2) ─────────────────────────────────────────────
SPLUNK_MCP_URL=
